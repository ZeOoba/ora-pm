#!/bin/sh
# ORA-PREPUSH-CONFIDENTIAL-SCAN -- git pre-push shim (Hard Invariant 3, fail-closed).
# Tracked source: scripts/git-hooks/pre-push. Installed by: python scripts/install_prepush_hook.py
# 1) ALWAYS runs the PINNED scan copy the installer placed beside this hook (untracked, so no
#    commit can change it). Missing copy, no usable Python 3.8+, or any nonzero => BLOCKED.
# 2) Then, when HEAD tracks the scan, runs HEAD's committed blob (never the worktree file) on the
#    same input; its verdict can only ADD blocks, so a no-op committed at HEAD cannot turn the
#    gate off. NOT a sandbox: that blob is committed code run with the user's credentials (as on
#    every push before this stage existed), and re-running the installer re-pins whatever scan
#    is checked out -- review scanner changes before pushing or reinstalling.
# git's ref lines are buffered once and reach both stages on stdin unchanged.
# Emergency bypass (only after verifying the push is clean): git push --no-verify
# PATH is rebuilt FIRST, with shell built-ins only, before this hook runs any external command
# or picks an interpreter (refute runs wf_39e200e8-462 and the 2026-11-13 shim refute; same
# pattern as the oxford-command-center pre-push wrapper). git runs this hook in the worktree
# root. Kept: absolute entries with no '.' or '..' segment whose PHYSICAL path (cd -P, so a
# junction or symlink is followed) is neither the current directory nor inside it, checked up to
# and including '/'. Parents are compared with test -ef, so case variants match; on MSYS the
# Windows spelling (pwd -W) is walked too, so a mount such as /usr/bin whose real folder sits
# inside the worktree is caught. Dropped: empty, '.', relative, '..' and unenterable entries. So
# nothing untracked in the worktree (a planted python, git, mktemp) can stand in for a tool this
# script runs after this block. (git itself resolves sh before any hook runs: out of reach.)
# Windows: children (python, git) must not search the current directory either.
NoDefaultCurrentDirectoryInExePath=1
export NoDefaultCurrentDirectoryInExePath
here=$(pwd -P) || exit 1
_inside() {
  _p=$1
  while [ -n "$_p" ]; do
    [ "$_p" -ef "$here" ] && return 0
    _next=${_p%/*}
    case "$_next" in ''|*:) _next=$_next/ ;; esac
    [ "$_next" = "$_p" ] && return 1
    _p=$_next
  done
  return 1
}
_safe=
_ifs=$IFS
IFS=:
set -f
for _d in $PATH; do
  case "$_d" in /*) ;; *) continue ;; esac
  case "$_d/" in */./*|*/../*) continue ;; esac
  cd -P -- "$_d" 2>/dev/null || continue
  _phys=$PWD
  _win=$(pwd -W 2>/dev/null) || _win=
  cd -P -- "$here" || exit 1
  _inside "$_phys" && continue
  [ -n "$_win" ] && _inside "$_win" && continue
  _safe=${_safe:+$_safe:}$_d
done
set +f
IFS=$_ifs
PATH=$_safe
export PATH
if [ -z "$PATH" ]; then
  echo "pre-push BLOCKED (fail-closed): no usable PATH entry outside the worktree." >&2
  exit 1
fi
block() { echo "pre-push BLOCKED (fail-closed): $1" >&2; exit 1; }
HOOK_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || block "cannot resolve the hooks directory."
PINNED="$HOOK_DIR/ora_prepush_confidential_scan.py"
[ -f "$PINNED" ] ||
  block "pinned scanner $PINNED is missing; re-run python scripts/install_prepush_hook.py."
PY=
for c in python python3 py; do
  if command -v "$c" >/dev/null 2>&1 &&
     "$c" -I -c "import sys; sys.exit(0 if sys.version_info >= (3, 8) else 1)" </dev/null >/dev/null 2>&1; then
    PY=$(command -v "$c")
    break
  fi
done
[ -n "$PY" ] || block "no Python 3.8+ found to run the confidentiality scan."
REFS=
TMPSCAN=
trap 'rm -f -- ${REFS:+"$REFS"} ${TMPSCAN:+"$TMPSCAN"}' EXIT
trap 'rm -f -- ${REFS:+"$REFS"} ${TMPSCAN:+"$TMPSCAN"}; exit 1' INT TERM HUP
REFS=$(mktemp "${TMPDIR:-/tmp}/ora-prepush-refs.XXXXXX") || block "cannot create a temp file for the ref lines."
cat > "$REFS" || block "cannot buffer the ref lines from git."
# -I: isolated, so PYTHON* variables and an untracked module beside the scan cannot load.
# Not exec: the EXIT trap removes the temp files.
"$PY" -I "$PINNED" "$@" < "$REFS" || exit 1
ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
REL=scripts/prepush_confidential_scan.py
# HEAD's committed blob is extracted to a temp file, so an untracked, edited or stat-cache-hidden
# worktree copy at $REL never stands in for it. Any failure once HEAD tracks it => BLOCKED.
if [ -n "$ROOT" ] && git --no-replace-objects -C "$ROOT" cat-file -e "HEAD:$REL" 2>/dev/null; then
  TMPSCAN=$(mktemp "${TMPDIR:-/tmp}/ora-prepush-scan.XXXXXX") ||
    block "cannot create a temp file for HEAD's scanner."
  git --no-replace-objects -C "$ROOT" cat-file blob "HEAD:$REL" > "$TMPSCAN" 2>/dev/null && [ -s "$TMPSCAN" ] ||
    block "cannot extract HEAD's $REL (or it is empty)."
  "$PY" -I "$TMPSCAN" "$@" < "$REFS"
  exit $?
fi
exit 0
