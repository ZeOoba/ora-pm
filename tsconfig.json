{
  "compilerOptions": {
    "target": "ES2022",
    "allowJs": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    // Suppresses type conflicts between @cloudflare/workers-types and DOM lib
    // (fetch/Request/Response overlap). Remove only if all dep types align.
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["@cloudflare/workers-types"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "server", "functions", "tests"]
}
